# All optional.

# Base64 32-byte key that encrypts exchange API secrets in data/sources.yaml.
# If unset, a key is generated once into data/secret.key — back that file up.
# Generate one with:  openssl rand -base64 32
VAULT_SECRET_KEY=

# Turn on HTTP basic auth for every page (recommended if you expose Vault beyond your LAN).
PORTFOLIO_PASSWORD=
PORTFOLIO_USER=admin

# ntfy access token, if your topic is protected.
NTFY_TOKEN=
