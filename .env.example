# All optional.

# Base64 32-byte key that encrypts exchange API secrets in data/sources.yaml. When set,
# YAML exports (backups, portfolios, sources) are also encrypted as a whole with it.
# If unset, a key is generated once into data/secret.key — back that file up.
# Generate one with:  openssl rand -base64 32
CRYPTKEEP_SECRET_KEY=

# Turn on HTTP basic auth for every page (recommended if you expose CryptKeep beyond your LAN).
PORTFOLIO_PASSWORD=
PORTFOLIO_USER=admin

# ntfy access token, if your topic is protected.
NTFY_TOKEN=
