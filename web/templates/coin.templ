package templates

import (
	"strconv"

	"crypto-portfolio/internal/portfolio"
)

// coinLink is an asset's name linking to its coin page. In the app it navigates like the
// other internal links; with a modifier key it opens normally.
templ coinLink(key, name string) {
	if key == "" {
		<span class="asset__name">{ name }</span>
	} else {
		<a class="asset__name asset__link" href={ templ.URL(coinHref(key)) } data-on:click={ navClick(coinHref(key), "") }>{ name }</a>
	}
}

// coinAnchor is just the link, for names already inside an .asset__name element.
templ coinAnchor(key, name string) {
	if key == "" {
		{ name }
	} else {
		<a class="asset__link" href={ templ.URL(coinHref(key)) } data-on:click={ navClick(coinHref(key), "") }>{ name }</a>
	}
}

// CoinFull is the coin page.
templ CoinFull(p CoinPage) {
	@Layout(p.Shell, coinBody(p))
}

templ coinBody(p CoinPage) {
	<div class="coin">
		<a class="back" href="/" data-on:click={ navClick("/", "all") }>
			@Icon("chevron-left", 16)
			Overview
		</a>
		<header class="coin-head">
			<div class="asset">
				@AssetMark(p.Symbol, p.LogoURL, p.ShowLogos)
				<div class="asset__id">
					<h1 class="h-title">{ coinTitle(p) }</h1>
					<span class="asset__sub">{ p.Symbol }</span>
				</div>
			</div>
			<div class="coin-head__price">
				<span class="display">
					@priceCell(p.Price, p.Now)
				</span>
				if p.Price != nil && p.Price.Change24h != nil {
					{{ text, dir := ChangePct(*p.Price.Change24h) }}
					<span class={ "chg", "chg--" + dir }>{ text } <span class="change__label">24h</span></span>
				}
			</div>
		</header>
		@CoinChart(p)
		<section class="card holdings" aria-labelledby="coin-held-h">
			<div class="holdings__head">
				<h2 id="coin-held-h" class="h-sec">Held in</h2>
				<span class="meta">
					@FigCoin(p.Amount, p.Symbol)
					·
					@FigFiat(p.ValueUSD)
				</span>
			</div>
			<div class="table-scroll">
				<table class="tbl tbl--coin">
					<thead>
						<tr>
							<th class="col-asset" scope="col">Source</th>
							<th class="col-amt num" scope="col">Holdings</th>
							<th class="col-val num" scope="col">Value</th>
						</tr>
					</thead>
					<tbody>
						for _, w := range p.Wallets {
							<tr>
								<td class="col-asset"><a class="asset__link" href={ templ.URL(walletHref(w.ID)) } data-on:click={ navClick(walletHref(w.ID), "") }>{ w.Label }</a></td>
								<td class="col-amt num">
									@FigCoin(w.Amount, p.Symbol)
								</td>
								<td class="col-val num">
									@FigFiat(w.ValueUSD)
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</section>
	</div>
}

func coinTitle(p CoinPage) string {
	if p.Name != "" {
		return p.Name
	}
	return p.Symbol
}

// coinRangeLabel is "past 30 days", the period a coin range covers.
func coinRangeLabel(rng string) string {
	return "past " + strconv.Itoa(CoinDays[rng]) + " days"
}

// CoinChart is the price chart and its range control. Its root is #coin-chart, so a range
// button patches just this.
templ CoinChart(p CoinPage) {
	<section id="coin-chart" class="card coin-chart" aria-label={ p.Symbol + " price" }>
		<div class="coin-chart__head">
			<div>
				<h2 class="h-sec">{ p.Symbol } price, { coinRangeLabel(p.Range) }</h2>
				if p.Change.Valid {
					{{ dir := Direction(p.Change.Pct) }}
					<div class={ "change", "change--" + dir }>
						<span>{ Arrow(dir) + " " + SignedPct(p.Change.Pct) }</span>
					</div>
				}
			</div>
			<div class="seg" role="group" aria-label="Chart range">
				for _, r := range CoinRanges {
					<button
						type="button"
						class={ "seg__btn", templ.KV("seg--on", r == p.Range) }
						aria-pressed={ boolStr(r == p.Range) }
						data-on:click={ coinRangeClick(p.AssetKey, r) }
					>{ r }</button>
				}
			</div>
		</div>
		if p.Loading {
			<div hidden data-init={ coinRangeClick(p.AssetKey, p.Range) }></div>
		}
		@chartFigure(p.Points, p.Symbol+" price, "+coinRangeLabel(p.Range), coinEmptyNote(p))
	</section>
}

// CoinChangeOf is the move over a series, first point to last.
func CoinChangeOf(points []portfolio.Point, rng string) portfolio.Change {
	c := portfolio.Change{Label: coinRangeLabel(rng)}
	if len(points) < 2 || points[0].V <= 0 {
		return c
	}
	first, last := points[0].V, points[len(points)-1].V
	c.Abs, c.Pct, c.Valid = last-first, (last-first)/first*100, true
	return c
}

func coinEmptyNote(p CoinPage) string {
	if p.Loading {
		return "Loading…"
	}
	return "No price history for " + p.Symbol
}
