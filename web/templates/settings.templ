package templates

import (
	"slices"
	"strconv"
	"strings"
	"time"
)

// SettingsFull is the settings screen: appearance, privacy, the list of sources and facts
// about this install.
templ SettingsFull(p SettingsPage) {
	@Layout(p.Shell, settingsBody(p))
}

type themeOpt struct{ Value, Label string }

var themeOpts = []themeOpt{{"system", "System"}, {"light", "Light"}, {"dark", "Dark"}}

templ settingsBody(p SettingsPage) {
	<div class="settings">
		<header class="page-head">
			<div class="page-head__title">
				<span class="eyebrow">CryptKeeper</span>
				<h1 class="h-title">Settings</h1>
			</div>
			<div class="page-head__actions">
				<a class="btn btn--primary btn--add" href="/sources/new">
					@Icon("plus", 16)
					Add source
				</a>
			</div>
		</header>
		<div class="settings-grid">
			<section class="card setting" aria-labelledby="set-theme-h">
				<div class="setting__text">
					<h2 id="set-theme-h" class="h-card">Appearance</h2>
					<p class="muted-text">Follow your system, or pin a theme. The choice is saved on this device.</p>
				</div>
				<div class="seg" role="group" aria-label="Theme">
					for _, o := range themeOpts {
						<button
							type="button"
							class="seg__btn"
							aria-pressed="false"
							data-on:click={ themeClick(o.Value) }
							data-attr:aria-pressed={ themePressed(o.Value) }
							data-class={ themeClass(o.Value) }
						>{ o.Label }</button>
					}
				</div>
			</section>
			<section class="card setting" aria-labelledby="set-privacy-h">
				<div class="setting__text">
					<h2 id="set-privacy-h" class="h-card">Privacy</h2>
					<p class="muted-text">Hide balances by default. Every fiat and coin amount is masked, and the eye button in the header toggles it. CryptKeeper remembers the last choice on this device.</p>
				</div>
				<div class="seg" role="group" aria-label="Balances">
					<button
						type="button"
						class="seg__btn"
						aria-pressed="true"
						data-on:click={ hideSetClick(false) }
						data-attr:aria-pressed={ hideSetPressed(false) }
						data-class={ hideSetClass(false) }
					>Shown</button>
					<button
						type="button"
						class="seg__btn"
						aria-pressed="false"
						data-on:click={ hideSetClick(true) }
						data-attr:aria-pressed={ hideSetPressed(true) }
						data-class={ hideSetClass(true) }
					>Hidden</button>
				</div>
			</section>
			<section class="card sources-card" aria-labelledby="set-sources-h">
				<div class="sources-card__head">
					<h2 id="set-sources-h" class="h-card">Sources</h2>
					<span class="meta">{ Plural(len(p.Wallets), "source") }</span>
					<a class="link" href="/sources/new">+ Add</a>
				</div>
				if len(p.Wallets) == 0 {
					<p class="empty-note">No sources yet.</p>
				} else {
					<ul class="src-list">
						for _, w := range p.Wallets {
							{{ glyph, label, tone := StatusView(w, time.Now()) }}
							<li class="src-row">
								<a class="src-row__main" href={ templ.URL(walletHref(w.ID)) } data-on:click={ navClick(walletHref(w.ID), "") }>
									<span class={ "src-dot", "src-dot--" + SourceTone(w.Kind) } aria-hidden="true"></span>
									<span class="src-row__text">
										<span class="src-row__name">{ w.Label }</span>
										<span class="src-row__kind">{ KindLabel(w) }</span>
										if w.Description != "" {
											<span class="src-row__desc">{ w.Description }</span>
										}
									</span>
								</a>
								<span class={ "chip", "chip--sm", "chip--" + tone }>
									<span aria-hidden="true">{ glyph }</span>
									{ label }
								</span>
								<a class="btn btn--secondary" href={ templ.URL(editHref(w.ID)) } aria-label={ "Edit " + w.Label }>Edit</a>
							</li>
						}
					</ul>
				}
			</section>
			@SettingsDisplay(p)
			@SettingsRefresh(p)
			@SettingsPrices(p)
			@SettingsBitcoin(p)
			@BackupIO(p)
			@ActivitySyncCard(p.Sync, p.Now)
			@SyncStream(syncInit)
			<section class="card setting" aria-labelledby="set-pf-h">
				<div class="setting__text">
					<h2 id="set-pf-h" class="h-card">Portfolios</h2>
					<p class="muted-text">Named views of your holdings, such as just your cold storage. Manage them here, and export or import them as a file.</p>
				</div>
				<a class="btn btn--secondary" href="/portfolios">Manage portfolios</a>
			</section>
			<section class="card about" aria-labelledby="set-about-h">
				<h2 id="set-about-h" class="h-card">About this install</h2>
				<dl class="kv">
					<div class="kv__row">
						<dt>Mode</dt>
						<dd>Read-only. CryptKeeper never moves funds.</dd>
					</div>
					<div class="kv__row">
						<dt>Data directory</dt>
						<dd class="mono">{ p.DataDir }</dd>
					</div>
					<div class="kv__row">
						<dt>Sign-in</dt>
						<dd>
							if p.AuthEnabled {
								Password required
							} else {
								Off. Anyone who can reach this address can open CryptKeeper.
							}
						</dd>
					</div>
					<div class="kv__row">
						<dt>Version</dt>
						<dd class="mono">{ p.Version }</dd>
					</div>
				</dl>
			</section>
		</div>
	</div>
}

// ErrorFull is a full-page message, for example a missing wallet.
templ ErrorFull(s Shell, msg string) {
	@Layout(s, errorBody(msg))
}

templ errorBody(msg string) {
	<div class="error-page">
		<section class="card empty" aria-labelledby="err-h">
			<span class="empty__icon">
				@Icon("alert", 28)
			</span>
			<h1 id="err-h" class="empty__title">Something went wrong</h1>
			<p class="empty__text">{ msg }</p>
			<a class="btn btn--secondary" href="/">Back to overview</a>
		</section>
	</div>
}

// SettingsDisplay holds display options stored on the server (they change what pages render).
templ SettingsDisplay(p SettingsPage) {
	<section id="settings-display" class="card setting" aria-labelledby="set-display-h">
		<div class="setting__text">
			<h2 id="set-display-h" class="h-card">Token logos</h2>
			<p class="muted-text">Show Solana token logos instead of ticker monograms. Logos load from the token issuers' servers, which can see your IP address.</p>
		</div>
		<form id="logos-form" method="post" action="/settings/logos" data-on:change={ logosChange }>
			<label class="choice" for="f-show-logos">
				<input class="choice__input" id="f-show-logos" type="checkbox" name="showLogos" value="on" checked?={ p.ShowLogos }/>
				<span class="choice__text">
					<span class="choice__title">Show token logos</span>
				</span>
			</label>
		</form>
	</section>
}

// SettingsRefresh sets how often prices refresh between balance refreshes.
templ SettingsRefresh(p SettingsPage) {
	<section id="settings-refresh" class="card setting" aria-labelledby="set-refresh-h">
		<div class="setting__text">
			<h2 id="set-refresh-h" class="h-card">Price updates</h2>
			<p class="muted-text">Balances refresh { Every(time.Duration(p.RefreshMinutes) * time.Minute) } (refreshMinutes in config.yaml). In between, CryptKeeper refreshes the prices of what they hold, without asking your wallets and exchanges again.</p>
		</div>
		<form id="price-every-form" class="form" method="post" action="/settings/price-interval" data-on:change={ priceEveryChange }>
			@selectField("priceMinutes", "Refresh prices", strconv.Itoa(p.PriceMinutes), priceEveryOpts(p.PriceMinutes, p.RefreshMinutes), "")
		</form>
	</section>
}

// priceEveryOpts are the choices for how often prices refresh: the usual steps below the
// balance interval (and current, if it isn't one), then with every balance refresh.
func priceEveryOpts(current, refresh int) []selectOpt {
	steps := []int{1, 2, 3, 5, 10, 15, 30}
	if current < refresh && !slices.Contains(steps, current) {
		steps = append(steps, current)
		slices.Sort(steps)
	}
	var opts []selectOpt
	for _, m := range steps {
		if m < refresh {
			every := Every(time.Duration(m) * time.Minute)
			opts = append(opts, selectOpt{strconv.Itoa(m), strings.ToUpper(every[:1]) + every[1:]})
		}
	}
	return append(opts, selectOpt{strconv.Itoa(refresh), "With the balances (" + Every(time.Duration(refresh)*time.Minute) + ")"})
}

// SettingsPrices holds the CoinGecko demo key used for historical prices of Solana tokens.
templ SettingsPrices(p SettingsPage) {
	<section id="settings-prices" class="card setting" aria-labelledby="set-prices-h">
		<div class="setting__text">
			<h2 id="set-prices-h" class="h-card">Historical prices</h2>
			<p class="muted-text">
				CoinGecko key:
				if p.PriceKeyFromEnv {
					set by COINGECKO_API_KEY
				} else if p.PriceKey != "" {
					<span class="mono">{ p.PriceKey }</span>
				} else {
					not set
				}
			</p>
		</div>
		<form id="prices-form" class="form" method="post" action="/settings/prices" data-on:submit={ pricesSubmit }>
			<div class="field">
				<label class="field__label" for="f-coingecko-key">CoinGecko demo key</label>
				<input
					class="input input--mono"
					id="f-coingecko-key"
					name="coingeckoKey"
					type="password"
					autocomplete="off"
					spellcheck="false"
					disabled?={ p.PriceKeyFromEnv }
					aria-describedby="f-coingecko-key-help"
				/>
				<p id="f-coingecko-key-help" class="field__help">Free demo key from coingecko.com/en/developers. Used for historical prices of Solana tokens Coinbase doesn't list (last 365 days).</p>
			</div>
			<div class="btn-row">
				<button type="submit" class="btn btn--secondary" disabled?={ p.PriceKeyFromEnv }>Save</button>
				<button type="button" class="btn btn--ghost" data-on:click={ pricesClear } disabled?={ p.PriceKeyFromEnv }>Clear</button>
			</div>
		</form>
	</section>
}

// SettingsBitcoin holds the Blockstream Explorer API key, which lifts the public servers'
// rate limits for Bitcoin wallets.
templ SettingsBitcoin(p SettingsPage) {
	<section id="settings-bitcoin" class="card setting" aria-labelledby="set-btc-h">
		<div class="setting__text">
			<h2 id="set-btc-h" class="h-card">Bitcoin API key</h2>
			<p class="muted-text">
				Blockstream key:
				if p.BlockstreamFromEnv {
					set by BLOCKSTREAM_CLIENT_ID
				} else if p.BlockstreamID != "" {
					<span class="mono">{ p.BlockstreamID }</span>
				} else {
					not set
				}
			</p>
		</div>
		<form
			id="bitcoin-key-form"
			class="form"
			method="post"
			action="/settings/bitcoin"
			data-indicator="savingBitcoinKey"
			data-on:submit={ bitcoinKeySubmit }
		>
			if p.BlockstreamNote != "" {
				<div role="status">
					if p.BlockstreamNoteErr {
						@Notice("loss", "alert") {
							{ p.BlockstreamNote }
						}
					} else {
						@Notice("gain", "check") {
							{ p.BlockstreamNote }
						}
					}
				</div>
			}
			<div class="field">
				<label class="field__label" for="f-blockstream-id">Client ID</label>
				<input
					class="input input--mono"
					id="f-blockstream-id"
					name="blockstreamId"
					type="text"
					autocomplete="off"
					spellcheck="false"
					disabled?={ p.BlockstreamFromEnv }
				/>
			</div>
			<div class="field">
				<label class="field__label" for="f-blockstream-secret">Client secret</label>
				<input
					class="input input--mono"
					id="f-blockstream-secret"
					name="blockstreamSecret"
					type="password"
					autocomplete="off"
					spellcheck="false"
					disabled?={ p.BlockstreamFromEnv }
					aria-describedby="f-blockstream-help"
				/>
				<p id="f-blockstream-help" class="field__help">From dashboard.blockstream.info → Manage Keys. Bitcoin wallets that use mempool.space or blockstream.info then go through Blockstream's API, which allows far more requests, with the public servers standing by. A wallet on your own node is never switched.</p>
			</div>
			<div class="btn-row">
				<button
					type="submit"
					class="btn btn--secondary"
					disabled?={ p.BlockstreamFromEnv }
					data-class="{'is-busy': $savingBitcoinKey}"
				>Save</button>
				<button type="button" class="btn btn--ghost" data-on:click={ bitcoinKeyClear } disabled?={ p.BlockstreamFromEnv }>Clear</button>
			</div>
		</form>
	</section>
}

// BackupIO exports and restores everything in one file: sources, portfolios, alert rules,
// manual cost basis, tax settings and closed tax years (secrets excluded unless asked for);
// Reset erases all of it and the database.
templ BackupIO(p SettingsPage) {
	<section id="backup-io" class="card pf-io" aria-labelledby="set-backup-h">
		<div class="pf-io__intro">
			<h2 id="set-backup-h" class="h-card">{ "Backup & restore" }</h2>
			if p.EncryptedExports {
				<p class="muted-text">One YAML file with everything you set up: sources, portfolios, alert rules, manual cost basis, tax settings, closed tax years and exchange API secrets. The whole file is encrypted with your <span class="mono">CRYPTKEEPER_SECRET_KEY</span>, so it only restores into a CryptKeeper with the same key. Include the database to keep your synced activity, price and chart history too; without it CryptKeeper fetches them again.</p>
			} else {
				<p class="muted-text">One YAML file with everything you set up: sources, portfolios, alert rules, manual cost basis, tax settings and closed tax years. Exchange API secrets are left out unless you include them encrypted, and encrypted secrets only restore into a CryptKeeper with the same secret key. Include the database to keep your synced activity, price and chart history too; without it CryptKeeper fetches them again.</p>
			}
		</div>
		<div class="pf-io__block pf-io__row">
			<div class="pf-io__text">
				<h3 class="h-card">Export</h3>
				if p.EncryptedExports {
					<p class="muted-text">Keep a copy of the key somewhere other than this server. Without it the file can't be restored.</p>
				} else {
					<p class="muted-text">Without secrets you re-enter exchange keys after restoring.</p>
				}
			</div>
			<form class="backup-export" method="get" action="/backup/export">
				<label class="backup-export__db" for="f-backup-db">
					<input id="f-backup-db" type="checkbox" name="db" value="1"/>
					Include the database
					<span class="muted-text">activity, price and chart history, saved wallet scans</span>
				</label>
				<div class="btn-row">
					<button class="btn btn--secondary" type="submit">
						@Icon("download", 16)
						if p.EncryptedExports {
							Export encrypted
						} else {
							Export
						}
					</button>
					if !p.EncryptedExports {
						<button class="btn btn--ghost" type="submit" name="secrets" value="1">With encrypted secrets</button>
					}
				</div>
			</form>
		</div>
		<div class="pf-io__block">
			<h3 class="h-card">Restore</h3>
			<form
				id="backup-import-form"
				class="form"
				method="post"
				action="/backup/import"
				enctype="multipart/form-data"
				data-indicator="restoring"
				data-on:submit={ backupImportSubmit }
			>
				<div class="field">
					<label class="field__label" for="f-backup-file">Backup file</label>
					<input
						class="input input--file"
						id="f-backup-file"
						name="file"
						type="file"
						accept=".yaml,.yml,text/yaml"
						required
						aria-describedby="f-backup-file-help"
					/>
					<p id="f-backup-file-help" class="field__help">A CryptKeeper backup, or a sources or portfolios export. A backup with the database restores it too: Merge adds the rows you don't have, Replace makes the database the backup's. Everything is checked before anything changes, and each file is backed up first.</p>
				</div>
				<fieldset class="pf-section">
					<legend class="field__label pf-legend">How to restore</legend>
					<div class="choices">
						@modeChoice("mode", "f-backup-merge", "merge", "Merge", "Add what's missing and update entries with the same id", true, false)
						@modeChoice("mode", "f-backup-replace", "replace", "Replace", "Each section in the file replaces yours; sections not in the file are kept", false, false)
					</div>
				</fieldset>
				<button
					type="submit"
					class="btn btn--secondary btn--block"
					data-attr:disabled="$restoring"
					data-class="{'is-busy': $restoring}"
				>Restore</button>
			</form>
			@BackupImportResult(p.BackupImport)
		</div>
		<div class="pf-io__block">
			<div class="pf-io__intro">
				<h3 class="h-card">Reset</h3>
				<p class="muted-text">Erase everything and start over as a fresh install: sources, portfolios, alert rules, cost basis, tax settings and closed years, and the whole database (activity, price and chart history, and the API keys and display options saved on this page). It can't be undone, so export a backup with the database first if you might want any of it back.</p>
				<p class="muted-text">Kept: config.yaml, .env, the secret key, and the automatic copies of old files in <span class="mono">{ p.DataDir + "/backups" }</span>.</p>
			</div>
			<form
				id="reset-form"
				class="form"
				method="post"
				action="/backup/reset"
				data-indicator="resetting"
				data-on:submit={ resetSubmit }
			>
				<div class="field">
					<label class="field__label" for="f-reset-confirm">Type { ResetWord } to confirm</label>
					<input
						class="input"
						id="f-reset-confirm"
						name="confirm"
						type="text"
						autocomplete="off"
						autocapitalize="characters"
						spellcheck="false"
						data-bind="resetConfirm"
						aria-describedby="reset-result"
					/>
				</div>
				<button
					type="submit"
					class="btn btn--danger btn--block"
					data-attr:disabled={ resetDisabled }
					data-class="{'is-busy': $resetting}"
				>Erase everything</button>
			</form>
			@ResetResult("")
		</div>
	</section>
}

// ResetResult says why a reset didn't run or where it stopped (patched after a reset; a
// reset that finishes opens the dashboard instead).
templ ResetResult(msg string) {
	<div id="reset-result" class="import-result" aria-live="polite">
		if msg != "" {
			@Notice("loss", "x") {
				{ msg }
			}
		}
	</div>
}

// BackupImportResult is the restore outcome (patched after an import).
templ BackupImportResult(r ImportOutcome) {
	<div id="backup-import-result" class="import-result" aria-live="polite">
		if r.Message != "" {
			if r.OK {
				@Notice("gain", "check") {
					{ r.Message }
				}
			} else {
				@Notice("loss", "x") {
					{ r.Message }
				}
			}
		}
	</div>
}
