package templates

import "strconv"

// Icon draws one of the inline 2px-stroke icons from the boards. Icons are decorative
// (aria-hidden); the control that holds them carries the accessible name. The name is also
// a class (icon-plus, icon-vault...) so app.css can tune a stroke width.
templ Icon(name string, size int) {
	<svg class={ "icon icon-" + name } width={ strconv.Itoa(size) } height={ strconv.Itoa(size) } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
		switch name {
			case "home":
				<path d="M3 12 12 4l9 8"></path>
				<path d="M5 10v10h14V10"></path>
			case "wallet":
				<rect x="3" y="6" width="18" height="14" rx="3"></rect>
				<path d="M16 13h.01"></path>
			case "vault":
				<rect x="3" y="6" width="18" height="14" rx="3"></rect>
				<path d="M3 10h18"></path>
			case "activity":
				<path d="M7 7h13l-3-3M17 17H4l3 3"></path>
			case "reports":
				<path d="M4 20V10M10 20V4M16 20v-7M22 20H2"></path>
			case "bell":
				<path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"></path>
				<path d="M13.7 21a2 2 0 0 1-3.4 0"></path>
			case "settings":
				<circle cx="12" cy="12" r="3"></circle>
				<path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z"></path>
			case "eye":
				<path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"></path>
				<circle cx="12" cy="12" r="3"></circle>
			case "refresh":
				<path d="M21 12a9 9 0 1 1-3-6.7L21 8"></path>
				<path d="M21 3v5h-5"></path>
			case "plus":
				<path d="M12 5v14M5 12h14"></path>
			case "search":
				<circle cx="11" cy="11" r="7"></circle>
				<path d="m20 20-3.5-3.5"></path>
			case "chevron-left":
				<path d="m15 18-6-6 6-6"></path>
			case "chevron-right":
				<path d="m9 18 6-6-6-6"></path>
			case "chevron-down":
				<path d="m6 9 6 6 6-6"></path>
			case "copy":
				<rect x="9" y="9" width="12" height="12" rx="2"></rect>
				<path d="M5 15V5a2 2 0 0 1 2-2h10"></path>
			case "qr":
				<rect x="3" y="3" width="7" height="7" rx="1"></rect>
				<rect x="14" y="3" width="7" height="7" rx="1"></rect>
				<rect x="3" y="14" width="7" height="7" rx="1"></rect>
				<path d="M14 14h3v3M21 14v7h-7"></path>
			case "shield":
				<path d="M12 3l8 4v5c0 5-3.5 8-8 9-4.5-1-8-4-8-9V7z"></path>
			case "alert":
				<path d="M12 3 2 21h20z"></path>
				<path d="M12 10v5M12 18h.01"></path>
			case "info":
				<circle cx="12" cy="12" r="9"></circle>
				<path d="M12 8h.01M11 12h1v4h1"></path>
			case "check":
				<circle cx="12" cy="12" r="9"></circle>
				<path d="m8 12 3 3 5-6"></path>
			case "x":
				<circle cx="12" cy="12" r="9"></circle>
				<path d="m9 9 6 6M15 9l-6 6"></path>
			case "device":
				<rect x="7" y="2" width="10" height="20" rx="2"></rect>
				<path d="M7 16h10"></path>
				<circle cx="12" cy="19" r="0.8"></circle>
			case "exchange":
				<path d="M3 10l9-6 9 6M5 10v8m4.5-8v8m5-8v8m4.5-8v8M3 21h18"></path>
			case "pencil":
				<path d="M12 20h9"></path>
				<path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"></path>
			case "arrow-down":
				<path d="M12 5v14M5 12l7 7 7-7"></path>
			case "clock":
				<circle cx="12" cy="12" r="9"></circle>
				<path d="M12 7v5l3 2"></path>
			case "scan":
				<path d="M3 7V5a2 2 0 0 1 2-2h2M17 3h2a2 2 0 0 1 2 2v2M21 17v2a2 2 0 0 1-2 2h-2M7 21H5a2 2 0 0 1-2-2v-2M7 12h10"></path>
		}
	</svg>
}
