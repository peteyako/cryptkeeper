package templates

import (
	"strconv"
	"strings"

	"cryptkeeper/internal/portfolio"
)

// OverviewFull is the whole overview page.
templ OverviewFull(p OverviewPage) {
	@Layout(p.Shell, overviewBody(p))
}

templ overviewBody(p OverviewPage) {
	@LiveStream()
	@Dashboard(p)
}

// Dashboard is everything the live stream refreshes: the header, value card, allocation,
// sources, holdings and watch list. Its root is #dashboard.
templ Dashboard(p OverviewPage) {
	<div id="dashboard" class="dashboard">
		<header class="page-head">
			<div class="page-head__title">
				<span class="eyebrow">Portfolio</span>
				<h1 class="h-title">{ p.PortfolioName }</h1>
				<details class="pf-menu">
					<summary class="pf-menu__btn" aria-label="Switch portfolio">
						@Icon("chevron-down", 16)
					</summary>
					<div class="pf-menu__list">
						for _, pf := range p.Portfolios {
							@portfolioLink(p.Shell, pf)
						}
						<a class="nav-item pf-menu__manage" href="/portfolios" data-on:click={ navClick("/portfolios", "") }>Manage portfolios</a>
					</div>
				</details>
				if normPF(p.PF) != "all" {
					<a class="btn btn--secondary btn--sm pf-edit" href={ templ.URL(pfEditHref(p.PF)) } aria-label={ "Edit " + p.PortfolioName }>Edit</a>
				}
			</div>
			<div class="page-head__actions">
				@pageHeadTools(p.Sync)
				<a class="btn btn--primary btn--add" href="/sources/new">
					@Icon("plus", 16)
					Add source
				</a>
			</div>
		</header>
		if len(p.Snap.Wallets) == 0 {
			@emptyState()
		} else {
			<div class="overview-grid">
				@ValueCard(p)
				@sourcesSection(p)
				@AllocationCard(p.Snap)
				@holdingsCard(p)
			</div>
			if len(p.Watch) > 0 {
				@watchCard(p)
			}
		}
	</div>
}

// ValueCard is the total, the change over the selected range, the range control and the
// chart. Its root is #value-card, so the range buttons patch just this.
templ ValueCard(p OverviewPage) {
	<section id="value-card" class="value-card" aria-label="Total value">
		<div class="value-card__total">
			<span class="label">Total value</span>
			<span class="display">
				@FigFiat(p.Snap.TotalUSD)
			</span>
			@changeLine(p.Change)
			if stable, ok := p.Snap.StableShare(); ok {
				@splitLine(stable)
			}
			if p.Snap.HasStale {
				<p class="note note--warn">
					<span aria-hidden="true">◐</span>
					Includes stale data
				</p>
			}
			if normPF(p.PF) != "all" && p.NetWorthShare > 0 {
				<p class="note">{ sharePct(p.NetWorthShare) } of all holdings</p>
			}
		</div>
		@RangeControl(p.Range)
		@chartSVG(p.Chart, p.Change.Label)
		if p.BackfillErr != "" {
			<p class="note note--warn" role="alert">{ p.BackfillErr }</p>
		}
		if p.BackfillNote != "" {
			<p class="note" role="status">{ p.BackfillNote }</p>
		}
		if p.BackfillDays > 0 {
			<div class="value-card__load">
				<button
					type="button"
					class="btn btn--secondary"
					data-indicator="backfilling"
					data-attr:disabled="$backfilling"
					data-class="{'is-busy': $backfilling}"
					data-on:click={ backfillClick }
				>
					<span class="load__idle">Load last { strconv.Itoa(p.BackfillDays) } days</span>
					<span class="load__busy">Loading…</span>
				</button>
			</div>
		}
	</section>
}

func sharePct(f float64) string {
	return strconv.Itoa(int(f*100+0.5)) + "%"
}

// SplitText is the invested / stable split as text: "82% invested · 18% stablecoins".
// Shares are rounded so the two always add up to 100%.
func SplitText(stable float64) string {
	s := int(min(max(stable, 0), 1)*100 + 0.5)
	return strconv.Itoa(100-s) + "% invested · " + strconv.Itoa(s) + "% stablecoins"
}

// SplitShort is the split for a fact with the label "Invested / stablecoins": "82% / 18%".
func SplitShort(stable float64) string {
	s := int(min(max(stable, 0), 1)*100 + 0.5)
	return strconv.Itoa(100-s) + "% / " + strconv.Itoa(s) + "%"
}

// splitLine is the invested / stable split: a two-tone bar and its text. Shares are
// not amounts, so the privacy mode leaves it alone.
templ splitLine(stable float64) {
	<div class="split" role="img" aria-label={ SplitText(stable) }>
		<span class="split__bar">
			<span class="split__invested" style={ splitStyle(1 - stable) }></span>
		</span>
		<span class="split__text">{ SplitText(stable) }</span>
	</div>
}

func splitStyle(invested float64) templ.SafeCSS {
	return templ.SafeCSS("width:" + strconv.FormatFloat(min(max(invested, 0), 1)*100, 'f', 1, 64) + "%;")
}

templ changeLine(c portfolio.Change) {
	if c.Valid {
		{{ dir := Direction(c.Pct) }}
		<div class={ "change", "change--" + dir }>
			<span class="change__abs">
				{ Arrow(dir) + " " }
				@FigText(ChangeAbs(c.Abs), "$ ••••")
			</span>
			<span>{ SignedPct(c.Pct) }</span>
			<span class="change__label">{ c.Label }</span>
		</div>
	} else {
		<div class="change change--flat">
			<span>—</span>
			<span class="change__label">Not enough history yet</span>
		</div>
	}
}

func chartLabel(label string) string {
	if label == "" {
		return "Portfolio value over the selected range"
	}
	return "Portfolio value, " + label
}

// chartSVG is the server-rendered portfolio value chart. Its values are private figures.
templ chartSVG(points []portfolio.Point, label string) {
	@chartFigure(points, chartLabel(label), "History fills in as CryptKeeper records your balances.", true, Fiat)
}

// chartFigure is the chart with its accessible name, the value labels on its gridlines,
// the times along its bottom, the hover readout chart.js drives, and the note shown when
// there is nothing to draw; the portfolio value chart and the coin price chart share it.
// It is an area chart: 3 gridlines, an accent area at 8% and a 2px line, in a viewBox
// that preserveAspectRatio="none" lets CSS stretch per breakpoint (so the text stays
// outside the SVG). private wraps every value as a figure the privacy mode masks; format
// turns a value into text.
templ chartFigure(points []portfolio.Point, aria, emptyNote string, private bool, format func(float64) string) {
	{{ line, area := SVGPath(points, 800, 220) }}
	{{ axes := ChartAxesOf(points, 800, 220, format) }}
	{{ hover := ChartHoverJSON(points, 800, 220, format) }}
	<div class="chart-wrap" data-chart?={ hover != "" } data-chart={ hover }>
		<div class="chart__y">
			for i, l := range axes.Y {
				<span class={ "chart__ylab", "chart__ylab--" + strconv.Itoa(i) }>
					if l != "" {
						@chartValue(l, private)
					}
				</span>
			}
		</div>
		<div class="chart__plot">
			<svg class="chart" viewBox="0 0 800 220" preserveAspectRatio="none" role="img" aria-label={ aria }>
				<path class="chart__grid" d={ gridPath(800, 220) }></path>
				if line != "" && len(points) >= 2 {
					<path class="chart__area" d={ area }></path>
					<path class="chart__line" d={ line }></path>
				}
			</svg>
			if hover != "" {
				<div class="chart__hover" hidden>
					<div class="chart__cross"></div>
					<div class="chart__dot"></div>
					<div class="chart__tip" role="status">
						<span class="chart__tip-t"></span>
						@chartValue("—", private)
					</div>
				</div>
			}
			if len(points) < 2 {
				<p class="chart__empty">{ emptyNote }</p>
			}
		</div>
		<div class="chart__x">
			for _, t := range axes.X {
				<span class="chart__xlab" style={ templ.SafeCSS(tickStyle(t)) }>{ t.Label }</span>
			}
		</div>
	</div>
}

// chartValue is a chart's value text: a private figure (masked by the privacy mode) or
// plain. In the tip, chart.js fills in the figure's value (or the plain span) on hover.
templ chartValue(text string, private bool) {
	if private {
		@FigText(text, "$ ••••")
	} else {
		<span class="chart__tip-v">{ text }</span>
	}
}

func allocStyle(s AllocSlice) templ.SafeCSS {
	return templ.SafeCSS("flex-grow:" + strconv.FormatFloat(s.Pct, 'f', 2, 64) + ";background:" + s.Color() + ";")
}

func swatchStyle(s AllocSlice) templ.SafeCSS {
	return templ.SafeCSS("background:" + s.Color() + ";")
}

func allocLabel(sl []AllocSlice) string {
	parts := make([]string, 0, len(sl))
	for _, s := range sl {
		parts = append(parts, s.Name+" "+s.PctText)
	}
	return "Allocation by asset: " + strings.Join(parts, ", ")
}

// AllocationCard is the bar plus a legend that always carries the percentage.
templ AllocationCard(snap portfolio.Snapshot) {
	{{ slices := Allocation(snap.Assets) }}
	<section class="card alloc" aria-labelledby="alloc-h">
		<div class="alloc__head">
			<h2 id="alloc-h" class="h-card">Allocation</h2>
			<span class="meta">by asset</span>
		</div>
		if len(slices) == 0 {
			<p class="empty-note">No priced holdings yet.</p>
		} else {
			<div class="alloc__bar" role="img" aria-label={ allocLabel(slices) }>
				for _, s := range slices {
					<span class="alloc__seg" style={ allocStyle(s) }></span>
				}
			</div>
			<ul class="alloc__legend">
				for _, s := range slices {
					if len(s.Parts) > 0 {
						<li class="alloc__group">
							<details>
								<summary class="alloc__row">
									<span class="alloc__swatch" style={ swatchStyle(s) } aria-hidden="true"></span>
									<span class="alloc__name">{ s.Name }</span>
									<span class="alloc__val">
										@FigFiat(s.ValueUSD)
									</span>
									<span class="alloc__pct">{ s.PctText }</span>
								</summary>
								<ul class="alloc__parts">
									for _, part := range s.Parts {
										<li class="alloc__row alloc__part">
											<span class="alloc__name">{ part.Name }</span>
											<span class="alloc__val">
												@FigFiat(part.ValueUSD)
											</span>
											<span class="alloc__pct">{ part.PctText }</span>
										</li>
									}
								</ul>
							</details>
						</li>
					} else {
						<li class="alloc__row">
							<span class="alloc__swatch" style={ swatchStyle(s) } aria-hidden="true"></span>
							<span class="alloc__name">{ s.Name }</span>
							<span class="alloc__val">
								@FigFiat(s.ValueUSD)
							</span>
							<span class="alloc__pct">{ s.PctText }</span>
						</li>
					}
				}
			</ul>
		}
	</section>
}

templ sourcesSection(p OverviewPage) {
	<section class="sources" aria-labelledby="sources-h">
		<div class="sec-head">
			<h2 id="sources-h" class="h-sec">Sources</h2>
			<a class="link link--wide" href="/wallets">Manage</a>
			<a class="link link--narrow" href="/sources/new">+ Add</a>
		</div>
		<div class="acct-grid">
			for _, w := range p.Snap.Wallets {
				@AccountCard(w, p.Now)
			}
		</div>
	</section>
}

const searchShow = `!$q || el.dataset.search.includes($q.toLowerCase())`

// cashPartShow shows a row of the cash group while the group is open, or, during a search,
// when it matches (the group's own row is hidden then).
const cashPartShow = `$q ? el.dataset.search.includes($q.toLowerCase()) : $cashOpen`

// cashToggle opens or closes the cash group in the holdings table.
const cashToggle = `$cashOpen = !$cashOpen`

// holdingsRow is one asset of the holdings table; a part of the cash group starts hidden and
// indented under the group's row.
templ holdingsRow(p OverviewPage, a portfolio.AssetRow, show string, part bool) {
	<tr
		class={ templ.KV("cash-part", part) }
		data-search={ SearchKey(a) }
		data-show={ show }
		if part {
			style="display:none"
		}
	>
		<td class="col-asset">
			<div class="asset">
				@AssetMark(a.Symbol, a.LogoURL, p.ShowLogos)
				<div class="asset__id">
					@coinLink(a.AssetKey, AssetName(a))
					<span class="asset__sub">{ Plural(len(a.HeldIn), "source") }</span>
				</div>
			</div>
		</td>
		<td class="col-held">{ strings.Join(a.HeldIn, " · ") }</td>
		<td class="col-price num">
			@priceCell(a.Price, p.Now)
		</td>
		<td class="col-amt num">
			@FigUnits(a.AssetKey, a.Amount, a.Symbol)
		</td>
		<td class="col-val num">
			if a.Priced {
				@FigFiat(a.ValueUSD)
			} else {
				<span class="muted">—</span>
			}
		</td>
		<td class="col-chg num">
			@changeCell(pct24h(a.Price), a.ValueUSD, a.Priced, "24 hour")
		</td>
		<td class="col-chg7 num">
			@changeCell(a.Change7d, a.ValueUSD, a.Priced, "7 day")
		</td>
		if len(p.PnL) > 0 {
			<td class="col-pnl num" data-show="$showPnl" style="display:none">
				@pnlCell(p.PnL[a.AssetKey])
			</td>
		}
	</tr>
}

// cashGroupRow is the holdings table's one line for cash and dollar stablecoins: their total
// value; its button opens their own rows under it. A search hides it and shows the matching
// rows instead.
templ cashGroupRow(p OverviewPage, it HoldingItem) {
	<tr class="cash-row" data-show="!$q">
		<td class="col-asset">
			<button
				type="button"
				class="cash-toggle"
				aria-expanded="false"
				data-attr:aria-expanded="$cashOpen ? 'true' : 'false'"
				data-on:click={ cashToggle }
			>
				<span class="disc disc--cash" aria-hidden="true">$</span>
				<span class="asset__id">
					<span class="asset__name">{ CashName }</span>
					<span class="asset__sub">{ Plural(len(it.Cash), "asset") }</span>
				</span>
				<span class="cash-toggle__chev" aria-hidden="true">
					@Icon("chevron-down", 16)
				</span>
			</button>
		</td>
		<td class="col-held">{ strings.Join(it.Asset.HeldIn, " · ") }</td>
		<td class="col-price num"><span class="muted">—</span></td>
		<td class="col-amt num"><span class="muted">—</span></td>
		<td class="col-val num">
			@FigFiat(it.Asset.ValueUSD)
		</td>
		<td class="col-chg num"><span class="chg chg--none" aria-label="No 24 hour change for a group">—</span></td>
		<td class="col-chg7 num"><span class="chg chg--none" aria-label="No 7 day change for a group">—</span></td>
		if len(p.PnL) > 0 {
			<td class="col-pnl num" data-show="$showPnl" style="display:none"><span class="chg chg--none" aria-label="No profit or loss for a group">—</span></td>
		}
	</tr>
}

templ holdingsCard(p OverviewPage) {
	<section class="card holdings" aria-labelledby="holdings-h">
		<div class="holdings__head">
			<h2 id="holdings-h" class="h-sec">Holdings</h2>
			<div class="holdings__tools">
				if len(p.PnL) > 0 {
					<button
						type="button"
						class="btn btn--secondary btn--sm pnl-toggle"
						aria-pressed="false"
						data-on:click="$showPnl = !$showPnl"
						data-attr:aria-pressed="$showPnl ? 'true' : 'false'"
						data-class="{'is-pressed': $showPnl}"
					>P/L</button>
				}
				<label class="search" for="p-search">
					@Icon("search", 15)
					<span class="sr-only">Search holdings</span>
					<input id="p-search" type="text" placeholder="Search holdings" autocomplete="off" data-bind="q"/>
				</label>
			</div>
		</div>
		if len(p.Snap.Assets) == 0 {
			<p class="empty-note">No holdings yet. Balances appear after the first sync.</p>
		} else {
			<div class="table-scroll">
				<table class="tbl tbl--holdings">
					<thead>
						<tr>
							<th class="col-asset" scope="col">Asset</th>
							<th class="col-held" scope="col">Held in</th>
							<th class="col-price num" scope="col">Price</th>
							<th class="col-amt num" scope="col">Holdings</th>
							<th class="col-val num" scope="col">Value</th>
							<th class="col-chg num" scope="col">24h</th>
							<th class="col-chg7 num" scope="col">7d</th>
							if len(p.PnL) > 0 {
								<th class="col-pnl num" scope="col" data-show="$showPnl" style="display:none">P/L</th>
							}
						</tr>
					</thead>
					<tbody>
						for _, it := range HoldingItems(p.Snap.Assets) {
							if len(it.Cash) > 0 {
								@cashGroupRow(p, it)
								for _, a := range it.Cash {
									@holdingsRow(p, a, cashPartShow, true)
								}
							} else {
								@holdingsRow(p, it.Asset, searchShow, false)
							}
						}
					</tbody>
				</table>
			</div>
		}
	</section>
}

// pnlCell is the optional P/L column: the arrow, sign and percent of the unrealized result
// with its dollar amount under it, or a dash when the cost of the asset is not known.
templ pnlCell(c PnLCell) {
	if c.OK {
		{{ text, dir := ChangePct(c.Pct) }}
		<span class="chg-cell">
			<span class={ "chg", "chg--" + dir }>{ text }</span>
			<span class={ "chg", "chg--usd", "chg--" + dir }>
				@FigText(ChangeAbs(c.Unrealized), "$ ••••")
			</span>
		</span>
	} else {
		<span class="chg chg--none" aria-label="No profit or loss available">—</span>
	}
}

templ watchCard(p OverviewPage) {
	<section class="card holdings watch" aria-labelledby="watch-h">
		<div class="holdings__head">
			<h2 id="watch-h" class="h-sec">Watching</h2>
			<span class="meta">prices only</span>
		</div>
		<div class="table-scroll">
			<table class="tbl tbl--watch">
				<thead>
					<tr>
						<th class="col-asset" scope="col">Asset</th>
						<th class="col-price num" scope="col">Price</th>
						<th class="col-chg num" scope="col">24h</th>
					</tr>
				</thead>
				<tbody>
					for _, r := range p.Watch {
						<tr>
							<td class="col-asset">
								<div class="asset">
									@Disc(r.Symbol)
									<div class="asset__id">
										<span class="asset__name">
											if r.Name != "" {
												{ r.Name }
											} else {
												{ r.Symbol }
											}
										</span>
										<span class="asset__sub">{ r.Symbol }</span>
									</div>
								</div>
							</td>
							<td class="col-price num">
								@priceCell(r.Price, p.Now)
							</td>
							<td class="col-chg num">
								@changeCell(pct24h(r.Price), 0, false, "24 hour")
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</section>
}
