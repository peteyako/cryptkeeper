package templates

import (
	"strconv"
	"strings"
	"time"
)

// PortfoliosFull is the portfolio manager: the list on one side, save and restore on the
// other.
templ PortfoliosFull(p PortfoliosPage) {
	@Layout(p.Shell, portfoliosBody(p))
}

templ portfoliosBody(p PortfoliosPage) {
	<div class="portfolios">
		<header class="page-head">
			<div class="page-head__title">
				<span class="eyebrow">Vault</span>
				<h1 class="h-title">Portfolios</h1>
			</div>
			<div class="page-head__actions">
				@HideButton()
				<a class="btn btn--primary btn--add" href="/portfolios/new">
					@Icon("plus", 16)
					New portfolio
				</a>
			</div>
		</header>
		<div class="pf-grid">
			<div class="pf-main">
				@PortfolioList(p)
			</div>
			<div class="pf-aside">
				@PortfolioIO(p)
			</div>
		</div>
	</div>
}

// PortfolioList is one card per portfolio, or the empty state. Its root is
// #portfolio-list, so a delete can patch just this.
templ PortfolioList(p PortfoliosPage) {
	<div id="portfolio-list" class="pf-list">
		if p.LoadError != "" {
			<div role="alert">
				@Notice("warn", "alert") {
					<p class="notice__line"><strong>Vault can't read portfolios.yaml.</strong> The list below may be incomplete.</p>
					<p class="notice__line pf-load-error">{ p.LoadError }</p>
					<p class="notice__line">Fix the file, or restore a backup.</p>
				}
			</div>
		}
		if len(p.Items) == 0 {
			if p.LoadError == "" {
				@portfoliosEmpty()
			}
		} else {
			<ul class="pf-items">
				for _, it := range p.Items {
					@portfolioCard(it)
				}
			</ul>
		}
	</div>
}

templ portfoliosEmpty() {
	<section class="card empty" aria-labelledby="pf-empty-h">
		<span class="empty__icon">
			@Icon("wallet", 28)
		</span>
		<h2 id="pf-empty-h" class="empty__title">No portfolios yet</h2>
		<p class="empty__text">A portfolio is a named view of your holdings: just your cold storage, just BTC and ETH, or whatever you like. Your wallets stay as they are.</p>
		<a class="btn btn--primary" href="/portfolios/new">
			@Icon("plus", 16)
			New portfolio
		</a>
	</section>
}

templ portfolioCard(it PortfolioItem) {
	<li class="card pf-item">
		<div class="pf-item__head">
			<div class="pf-item__id">
				<h2 class="h-card pf-item__name">{ it.Name }</h2>
				<span class="meta">{ ShareText(it.Share) }</span>
			</div>
			<span class="pf-item__value">
				@FigFiat(it.ValueUSD)
			</span>
		</div>
		<dl class="pf-facts">
			<div class="pf-fact">
				<dt>Wallets</dt>
				<dd>{ it.WalletsText }</dd>
			</div>
			<div class="pf-fact">
				<dt>Assets</dt>
				<dd>{ it.AssetsText }</dd>
			</div>
			<div class="pf-fact">
				<dt>Watching</dt>
				<dd>
					if it.WatchCount > 0 {
						{ Plural(it.WatchCount, "asset") }
					} else {
						None
					}
				</dd>
			</div>
		</dl>
		if len(it.Missing) > 0 {
			@Notice("warn", "alert") {
				{ missingText(it.Missing) }<span class="mono">{ strings.Join(it.Missing, ", ") }</span>. Edit the portfolio to clear it.
			}
		}
		<div class="pf-item__actions">
			<a class="btn btn--secondary" href={ templ.URL(pfHref(it.ID)) } aria-label={ "Open " + it.Name }>Open</a>
			<a class="btn btn--secondary" href={ templ.URL(pfEditHref(it.ID)) } aria-label={ "Edit " + it.Name }>Edit</a>
			<a class="btn btn--secondary" href={ templ.URL(pfExportHref(it.ID)) } download aria-label={ "Export " + it.Name }>
				@Icon("download", 16)
				Export
			</a>
			<button type="button" class="btn btn--danger" aria-label={ "Delete " + it.Name } data-on:click={ pfDeleteClick(it.ID, it.Name) }>Delete</button>
		</div>
	</li>
}

// PortfolioIO is the Save & restore panel: export, import and the backups list. Its root
// is #portfolio-io.
templ PortfolioIO(p PortfoliosPage) {
	<section id="portfolio-io" class="card pf-io" aria-labelledby="pf-io-h">
		<div class="pf-io__intro">
			<h2 id="pf-io-h" class="h-card">{ "Save & restore" }</h2>
			<p class="muted-text">Your portfolios live in one small YAML file. Export a copy to keep somewhere safe, or import one from another Vault.</p>
		</div>
		<div class="pf-io__block pf-io__row">
			<div class="pf-io__text">
				<h3 class="h-card">Export</h3>
				<p class="muted-text">Every portfolio in one file. To export a single one, use its Export button.</p>
			</div>
			<a class="btn btn--secondary" href="/portfolios/export" download>
				@Icon("download", 16)
				Export all
			</a>
		</div>
		<div class="pf-io__block">
			<h3 class="h-card">Import</h3>
			<form
				id="import-form"
				class="form"
				method="post"
				action="/portfolios/import"
				enctype="multipart/form-data"
				data-indicator="importing"
				data-on:submit={ importSubmit }
			>
				<div class="field">
					<label class="field__label" for="f-import-file">Portfolio file</label>
					<input
						class="input input--file"
						id="f-import-file"
						name="file"
						type="file"
						accept=".yaml,.yml,text/yaml"
						required
						aria-describedby="f-import-file-help"
					/>
					<p id="f-import-file-help" class="field__help">A YAML file exported from Vault. It is checked before anything changes.</p>
				</div>
				<fieldset class="pf-section">
					<legend class="field__label pf-legend">How to import</legend>
					<div class="choices">
						@modeChoice("mode", "f-import-merge", "merge", "Merge", "Add new portfolios and update ones with the same id", true, false)
						@modeChoice("mode", "f-import-replace", "replace", "Replace all", "Your file becomes the whole list", false, false)
					</div>
				</fieldset>
				<button
					type="submit"
					class="btn btn--secondary btn--block"
					data-attr:disabled="$importing"
					data-class="{'is-busy': $importing}"
				>Import</button>
			</form>
			@ImportResultView(p.Import)
		</div>
		<div class="pf-io__block">
			<div class="pf-io__head">
				<h3 class="h-card">Backups</h3>
				<span class="meta">{ Plural(len(p.Backups), "backup") }</span>
			</div>
			if len(p.Backups) == 0 {
				<p class="empty-note">No backups yet — one is made before every change.</p>
			} else {
				<ul class="backup-list">
					for _, b := range p.Backups {
						<li class="backup-row">
							<div class="backup-row__text">
								<time class="backup-row__time" datetime={ b.Time.Format(time.RFC3339) }>{ BackupWhen(b.Time) }</time>
								<span class="meta">{ Ago(b.Time, p.Now) } · { ByteSize(b.Size) }</span>
							</div>
							<button
								type="button"
								class="btn btn--ghost"
								aria-label={ "Restore the backup from " + BackupWhen(b.Time) }
								data-on:click={ restoreClick(b.Name) }
							>Restore</button>
						</li>
					}
				</ul>
			}
		</div>
	</section>
}

// ImportResultView is the outcome of an import or restore. Its root is #import-result; the
// zero value renders an empty container.
templ ImportResultView(r ImportOutcome) {
	<div id="import-result" class="import-result" aria-live="polite">
		if r.Message != "" {
			if r.OK {
				@Notice("gain", "check") {
					{ r.Message }
				}
			} else {
				@Notice("loss", "x") {
					{ r.Message }
				}
			}
		}
	</div>
}

// modeChoice is a radio shown as a bordered, tappable row. The whole row is the label, so
// the touch target is the row (at least 48px), not the 20px radio. bind turns it into a
// Datastar-bound radio (the editor's wallets and assets modes); the import form's radios
// are plain.
templ modeChoice(name, id, value, title, help string, checked, bind bool) {
	<label class="choice" for={ id }>
		<input
			class="choice__input"
			type="radio"
			id={ id }
			name={ name }
			value={ value }
			checked?={ checked }
			if bind {
				data-bind={ name }
			}
		/>
		<span class="choice__text">
			<span class="choice__title">{ title }</span>
			if help != "" {
				<span class="choice__help">{ help }</span>
			}
		</span>
	</label>
}

// PortfolioFormFull is the create / edit form, inside the normal app shell.
templ PortfolioFormFull(p PortfolioFormPage) {
	@Layout(p.Shell, portfolioFormBody(p))
}

templ portfolioFormBody(p PortfolioFormPage) {
	<div class="pf-editor" data-signals={ pfFormSignals(p) }>
		<a class="back" href="/portfolios">
			@Icon("chevron-left", 16)
			Portfolios
		</a>
		<header class="pf-editor__head">
			<h1 class="h-title">{ pfFormTitle(p) }</h1>
			<p class="lede">{ pfFormLede(p) }</p>
		</header>
		<form
			id="portfolio-form"
			class="form card pf-form"
			method="post"
			action={ templ.URL(pfFormAction(p.EditID)) }
			data-indicator="saving"
			data-on:submit={ pfSubmitClick(p.EditID) }
		>
			if p.isEdit() {
				<input type="hidden" name="editId" value={ p.EditID }/>
			}
			@FormErrors(p.Errors)
			@textField(fieldSpec{Name: "name", Label: "Name", Value: p.Name, Placeholder: "e.g. Long-term", Err: p.Errors["name"], Required: true, MaxLen: 60})
			@pfWalletsSection(p)
			@pfAssetsSection(p)
			@textField(fieldSpec{
				Name: "watch", Label: "Watch only (shown with live price, not counted)", Value: p.Watch,
				Placeholder: "ETH AVAX spl:<mint>", Err: p.Errors["watch"], Mono: true,
				Help: "Separate with spaces or commas. These never add to your total.",
			})
			<div class="form-actions">
				<a class="btn btn--ghost" href="/portfolios">Cancel</a>
				<button
					type="submit"
					class="btn btn--primary btn--submit"
					data-attr:disabled="$saving"
					data-class="{'is-busy': $saving}"
				>{ pfSaveLabel(p) }</button>
			</div>
		</form>
	</div>
}

templ pfWalletsSection(p PortfolioFormPage) {
	{{ note := fieldSpec{Name: "wallets", Err: p.Errors["wallets"], Help: "Only holdings in these wallets count."} }}
	{{ missing := p.missingWallets() }}
	<fieldset class="pf-section" aria-describedby={ note.Describe() }>
		<legend class="field__label pf-legend">Wallets</legend>
		<div class="choices">
			@modeChoice("walletsMode", "f-walletsMode-all", "all", "All wallets", "Every wallet, including ones you add later.", p.AllWallets, true)
			@modeChoice("walletsMode", "f-walletsMode-selected", "selected", "Only selected wallets", "", !p.AllWallets, true)
		</div>
		<div
			class="pf-pick"
			data-show={ pfModeSelected("walletsMode") }
			if p.AllWallets {
				style="display:none"
			}
		>
			if len(missing) > 0 {
				@Notice("warn", "alert") {
					{ missingText(missing) }<span class="mono">{ strings.Join(missing, ", ") }</span>. Saving removes it.
				}
			}
			if len(p.WalletOptions) == 0 {
				<p class="field__help">No wallets yet. <a href="/sources/new">Add a source</a> first.</p>
			} else {
				for gi, g := range walletGroups(p.WalletOptions) {
					<div class="choice-group" role="group" aria-labelledby={ "pf-wg-" + strconv.Itoa(gi) }>
						<p id={ "pf-wg-" + strconv.Itoa(gi) } class="group-label">{ g.Title }</p>
						<div class="pick-box">
							for _, r := range g.Rows {
								<label class="choice choice--row" for={ "pf-w-" + strconv.Itoa(r.Index) }>
									<input
										class="choice__input"
										type="checkbox"
										id={ "pf-w-" + strconv.Itoa(r.Index) }
										name="wallets"
										value={ r.ID }
										checked?={ p.SelectedWallets[r.ID] }
									/>
									<span class={ "src-dot", "src-dot--" + SourceTone(r.Kind) } aria-hidden="true"></span>
									<span class="choice__text">
										<span class="choice__title">{ r.Label }</span>
									</span>
									<span class="choice__meta">{ kindCaption(r.Kind) }</span>
								</label>
							}
						</div>
					</div>
				}
			}
			@fieldNote(note)
		</div>
	</fieldset>
}

templ pfAssetsSection(p PortfolioFormPage) {
	{{ note := fieldSpec{Name: "assets", Err: p.Errors["assets"], Help: "Only these assets count. If you also picked wallets, a holding must match both."} }}
	<fieldset class="pf-section pf-assets" aria-describedby={ note.Describe() }>
		<legend class="field__label pf-legend">Assets</legend>
		<div class="choices">
			@modeChoice("assetsMode", "f-assetsMode-all", "all", "All assets", "Everything held in the wallets above.", p.AllAssets, true)
			@modeChoice("assetsMode", "f-assetsMode-selected", "selected", "Only selected assets", "", !p.AllAssets, true)
		</div>
		<div
			class="pf-pick"
			data-show={ pfModeSelected("assetsMode") }
			if p.AllAssets {
				style="display:none"
			}
		>
			if len(p.AssetOptions) == 0 {
				<p class="field__help">Nothing is held yet. Add assets by symbol below.</p>
			} else {
				<label class="search" for="pf-asset-q">
					@Icon("search", 15)
					<span class="sr-only">Search your assets</span>
					<input
						id="pf-asset-q"
						type="text"
						placeholder="Search your assets"
						autocomplete="off"
						data-bind="assetQ"
						data-on:keydown={ noEnterSubmit }
					/>
				</label>
				<div class="pick-box pick-box--scroll">
					for i, o := range p.AssetOptions {
						<label
							class="choice choice--row"
							for={ "pf-a-" + strconv.Itoa(i) }
							data-search={ AssetSearchKey(o) }
							data-show={ assetShow }
						>
							<input
								class="choice__input"
								type="checkbox"
								id={ "pf-a-" + strconv.Itoa(i) }
								name="assets"
								value={ o.Key }
								checked?={ p.SelectedAssets[o.Key] }
							/>
							@Disc(o.Symbol)
							<span class="choice__text">
								<span class="choice__title">{ o.Symbol }</span>
								if o.Name != "" && o.Name != o.Symbol {
									<span class="choice__help">{ o.Name }</span>
								}
							</span>
							<span class="choice__meta mono">
								@FigFiat(o.ValueUSD)
							</span>
						</label>
					}
				</div>
			}
			@fieldNote(note)
			@textField(fieldSpec{
				Name: "extraAssets", Label: "Add assets you don't hold yet", Value: p.ExtraAssets,
				Placeholder: "ETH, spl:<mint>", Err: p.Errors["extraAssets"], Mono: true,
				Help: "Separate with spaces or commas. For a Solana token, use spl: and its mint address.",
			})
		</div>
	</fieldset>
}
